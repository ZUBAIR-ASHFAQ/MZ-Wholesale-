POSTGRES_DB=wholesale_erp
POSTGRES_USER=wholesale_erp
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://wholesale_erp:replace-with-a-strong-database-password@database:5432/wholesale_erp
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
WEB_ADMIN_URL=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=3000
APP_VERSION=1.0.0
APP_BUILD=local
NODE_ENV=development
LOG_LEVEL=info
VITE_API_URL=http://localhost:3000
ERP_ADMIN_NAME=
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
ERP_BUSINESS_NAME=Example Wholesale Store
ERP_BUSINESS_PHONE=+92 300 0000000
ERP_BUSINESS_EMAIL=
ERP_BUSINESS_ADDRESS=Lahore, Pakistan
ERP_BUSINESS_LOGO_URL=

# Dedicated PostgreSQL database used only by integration tests.
TEST_DATABASE_URL=postgresql://wholesale_erp_test:wholesale_erp_test_password@localhost:5433/wholesale_erp_test

# Production backup variables are used by deployment/backup-postgres.sh.
# Keep the real encryption password and remote target only on the production server.
BACKUP_DIR=/var/backups/wholesale-erp
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_REMOTE_TARGET=
# Production notes:
# - set NODE_ENV=production
# - WEB_ADMIN_URL must be the real HTTPS admin-panel origin, for example https://erp.example.com
# - VITE_API_URL must be the browser-visible HTTPS API origin, for example https://api.example.com
# - if the PostgreSQL provider requires TLS, use its documented DATABASE_URL SSL option (commonly sslmode=require)
# - keep the real .env only on the server; it is ignored by .gitignore

