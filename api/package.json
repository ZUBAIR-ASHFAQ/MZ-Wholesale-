{
  "name": "wholesale-erp-api",
  "version": "0.10.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/commands/migrate.ts",
    "db:migrate:production": "node dist/commands/migrate.js",
    "initialize:system": "tsx src/commands/initialize-system.ts",
    "initialize:system:production": "node dist/commands/initialize-system.js",
    "bootstrap:admin": "tsx src/commands/bootstrap-admin.ts",
    "bootstrap:admin:production": "node dist/commands/bootstrap-admin.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --custom",
    "db:check": "tsx src/commands/validate-migrations.ts",
    "check": "pnpm typecheck && pnpm test && pnpm db:check",
    "test": "pnpm test:unit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:integration:reset": "tsx src/commands/reset-test-database.ts",
    "test:integration": "pnpm test:integration:reset && tsx --test --test-concurrency=1 test/integration/**/*.test.ts",
    "test:integration:up": "docker compose -f ../docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f ../docker-compose.test.yml down --remove-orphans"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "10.2.1",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.6",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "exceljs": "4.4.0",
    "pg": "8.22.0",
    "zod": "4.4.3",
    "pdfkit": "0.19.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.3",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/pdfkit": "0.17.6"
  },
  "packageManager": "pnpm@10.15.0"
}
